# Copy to .env (gitignored) and fill in. Never commit real values.

# LLM providers. Embeddings use OpenAI; chat models come in a later phase.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local database (defaults match docker-compose.yml)
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=postgres

# Google Drive folder synced into the knowledge base. The service-account key
# itself lives in Rails credentials (see README), not in ENV.
GOOGLE_DRIVE_FOLDER_ID=
