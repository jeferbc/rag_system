# Copy to .env (gitignored) and fill in. Never commit real values.

# LLM providers. Embeddings use Gemini by default (key from Google AI Studio:
# https://aistudio.google.com/apikey). Chat models come in a later phase.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding model (any RubyLLM model that can output 1536 dimensions, e.g.
# text-embedding-3-small on OpenAI). Changing it requires re-embedding:
# bin/rails documents:ingest ALL=1
# EMBEDDING_MODEL=gemini-embedding-2

# Local database (defaults match docker-compose.yml)
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=postgres

# HTTP Basic auth for /admin. With no password set, /admin is open in
# development and locked everywhere else.
# ADMIN_USER=admin
ADMIN_PASSWORD=
